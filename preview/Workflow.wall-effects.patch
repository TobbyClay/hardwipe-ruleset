+/** Native v14 Regions may contain several placed areas; clipped polygons are not separate placements. */
+export function countPlacedTemplateAreas(document: { documentName?: string; shapes?: unknown; flags?: Record<string, unknown> }): number {
+  if (document.documentName !== "Region") return 1; // Legacy MeasuredTemplate: one document per area.
+  const walled = document.flags?.["walled-regions"] as { sourceShapes?: unknown } | undefined;
+  const shapes = Array.isArray(walled?.sourceShapes) ? walled.sourceShapes : Array.isArray(document.shapes) ? document.shapes : [];
+  return shapes.filter(shape => shape && typeof shape === "object" && !(shape as { hole?: boolean }).hole).length;
+}

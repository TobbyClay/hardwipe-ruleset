<div class="hardwipe-wall-types-body scrollable">
  <p class="hint">{{localize "HARDWIPE.WallTypes.Intro"}}</p>
  <div class="form-group">
    <label for="{{rootId}}-selected">{{localize "HARDWIPE.WallTypes.Type"}}</label>
    <div class="form-fields">
      <select id="{{rootId}}-selected" name="selectedType" {{#unless hasType}}disabled{{/unless}}>
        {{#each types}}<option value="{{id}}" {{#if selected}}selected{{/if}}>{{name}}</option>{{/each}}
        {{#unless hasType}}<option>{{localize "HARDWIPE.WallTypes.None"}}</option>{{/unless}}
      </select>
      <button type="button" class="icon fa-solid fa-plus" data-action="create" data-tooltip aria-label="{{localize "HARDWIPE.WallTypes.New"}}"></button>
    </div>
  </div>
  {{#if hasType}}
  <fieldset>
    <legend>{{localize "HARDWIPE.WallTypes.Details"}}</legend>
    <div class="form-group">
      <label for="{{rootId}}-name">{{localize "HARDWIPE.WallTypes.Name"}}</label>
      <div class="form-fields">
        <input id="{{rootId}}-name" name="name" type="text" value="{{type.name}}" maxlength="80" required>
      </div>
    </div>
    <div class="form-group">
      <label for="{{rootId}}-material">{{localize "HARDWIPE.WallTypes.Material"}}</label>
      <div class="form-fields">
        <input id="{{rootId}}-material" name="material" type="text" value="{{type.material}}" maxlength="80" list="{{rootId}}-materials" required>
        <datalist id="{{rootId}}-materials">{{#each surfaces}}<option value="{{this}}"></option>{{/each}}</datalist>
      </div>
      <p class="hint">{{localize "HARDWIPE.WallTypes.MaterialHint"}}</p>
    </div>
  </fieldset>
  {{> "modules/hardwipe-ruleset/templates/wall-durability.hbs" rootId=rootId values=type}}
  {{else}}
  <p class="hint">{{localize "HARDWIPE.WallTypes.Empty"}}</p>
  {{/if}}
</div>

<div class="hardwipe-heat-config-body">
  <header class="hardwipe-heat-config-header">
    <span>{{localize "HARDWIPE.Heat.Title"}}</span>
    <strong>{{sceneName}}</strong>
  </header>

  <div class="form-group">
    <label>{{localize "HARDWIPE.Heat.Budget"}}</label>
    <div class="form-fields">
      <input type="number" name="max" value="{{defaultMax}}" min="1" step="1" autofocus>
    </div>
    <p class="notes">{{localize "HARDWIPE.Heat.BudgetHint"}}</p>
  </div>

  <div class="form-group">
    <label for="hardwipe-heat-card-style">{{localize "HARDWIPE.Heat.CardStyle"}}</label>
    <div class="form-fields">
      <select id="hardwipe-heat-card-style" name="cardStyle">{{selectOptions cardStyles selected=cardStyle localize=true}}</select>
    </div>
    <p class="notes">{{localize "HARDWIPE.Heat.CardStyleHint"}}</p>
  </div>

  <footer class="form-footer">
    <button type="submit">
      <i class="fas fa-satellite-dish"></i>
      {{localize "HARDWIPE.Heat.StartMission"}}
    </button>
  </footer>
</div>
